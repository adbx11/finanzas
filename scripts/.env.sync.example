# Copiar a scripts/.env.sync y completar credenciales.
# NO commitear .env.sync (contiene passwords).

# --- Origen: base de producción (solo lectura para mysqldump) ---
SYNC_SOURCE_HOST=192.168.10.156
SYNC_SOURCE_PORT=3306
SYNC_SOURCE_DATABASE=finanzas
SYNC_SOURCE_USER=readonly_user
SYNC_SOURCE_PASSWORD=cambiar

# --- Destino: base local de desarrollo ---
SYNC_TARGET_HOST=127.0.0.1
SYNC_TARGET_PORT=3306
SYNC_TARGET_DATABASE=finanzas_dev
SYNC_TARGET_USER=finanzas_dev
SYNC_TARGET_PASSWORD=cambiar

# --- Opciones ---
# Comprimir dump con gzip (1=sí, 0=no)
SYNC_COMPRESS=1

# Tablas a excluir del dump (mining, crypto, etc.)
SYNC_SKIP_TABLES=mining_log,mining_payout_log

# Reset de password tras restore (1=sí, 0=no)
# Usar 0 si todavía probás con el sistema Java legacy (usa HMAC, no bcrypt).
# Usar 1 cuando Laravel v2 esté operativo con tabla users / bcrypt.
SYNC_RESET_PASSWORD=0

# Solo aplica si SYNC_RESET_PASSWORD=1
SYNC_DEV_ADMIN_USER=admin
SYNC_DEV_ADMIN_PASSWORD=dev123456

# Directorio temporal para dumps (debe existir y ser escribible)
SYNC_TMP_DIR=./storage/tmp
